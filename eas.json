{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },

    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },

    "android-compile-check": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },

    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },

    "production": {
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  }
}
