{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/ios/Pods/**": true,
    "**/ios/build/**": true,
    "**/dev/sim-view/vendor/**": true,
    "**/tools/corpus/ocr/**": true,
    "**/tools/metrics/out/**": true,
    "**/.git/objects/**": true,
    "**/.expo/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/ios/Pods": true,
    "**/ios/build": true,
    "**/dev/sim-view/vendor": true,
    "**/tools/corpus/ocr": true,
    "**/.expo": true
  }
}
