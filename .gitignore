# ---------------------------------------------------------------------------
# Carta — .gitignore
#
# Two jobs here. The usual one (keep build junk out), and a privacy one:
# this repo is public at submission time, so nothing that could contain a real
# person's benefit information may ever be committed. See the PRIVACY section.
# ---------------------------------------------------------------------------

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Expo ---
.expo/
dist/
web-build/
expo-env.d.ts

# --- Native build output ---
# ios/ and android/ are generated by `expo prebuild` (Continuous Native
# Generation). They are regenerable, so they stay out of the repo — except for
# our own native module source, which is un-ignored at the bottom of this file.
/ios/
/android/
*.xcworkspace
*.xcuserstate
xcuserdata/
Pods/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# --- Metro / build caches ---
.metro-health-check*
*.tsbuildinfo
.eslintcache
.jest-cache/

# --- macOS ---
.DS_Store
*.pem

# --- Logs ---
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# --- Env / secrets ---
# There are no API keys in this project by design (SPEC §0: no backend, no
# accounts, no API keys). These entries exist so that if one is ever created by
# accident, it does not get committed.
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# PRIVACY — do not remove these rules
# ---------------------------------------------------------------------------

# Anything under a private/ directory, anywhere in the tree. This is the
# escape hatch for working with material that must not be published: use it
# and it can never be committed by accident.
private/
**/private/

# Real benefit notices. CLAUDE.md and SPEC.md §8.1 forbid using a real person's
# notice at all; this is the belt-and-braces version of that rule.
**/real-notices/
**/*.real.png
**/*.real.jpg
**/*.real.jpeg
**/*.real.pdf

# The local LLM model (Phase 4). ~1 GB, downloaded on device at runtime,
# never bundled (SPEC §3).
*.gguf
/models/

# On-device databases and OCR dumps pulled off the phone for debugging. These
# can contain notice text.
*.db
*.db-shm
*.db-wal
*.sqlite
/debug-dumps/

# ---------------------------------------------------------------------------
# EXPLICITLY TRACKED
# ---------------------------------------------------------------------------

# The golden corpus is synthetic — generated from fictional data (SPEC §8.1) —
# so it is committed on purpose, images and all. It is the evidence behind the
# metrics table in the README.
!/tools/corpus/**
!/tools/forms/**

# The cached OCR text layer is committed too, and deliberately. It is what lets
# the metrics harness run in bare Node on any machine with no camera, no
# simulator and no OCR engine, and it holds the text fixed so that when a number
# moves, the extraction cascade is the only thing that could have moved it.
!/tools/corpus/ocr/**

# ---------------------------------------------------------------------------
# Metrics harness build output
# ---------------------------------------------------------------------------

# The compiled Swift OCR producer. Rebuilt by `npm run corpus:ocr` on demand.
/tools/metrics/ocr/.build/
