{
  "name": "carta",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/extraction",
    "test": "jest",
    "test:node": "jest --selectProjects node",
    "test:app": "jest --selectProjects app"
  },
  "comments": {
    "overrides": "We do not ship a web build (SPEC.md §10 forbids a web version), but expo-router's dev tooling (@expo/router-server, @expo/ui) still pulls react-dom transitively. Left alone npm resolves it to a newer react-dom that demands a newer react than React Native 0.86.2 ships with. Pinning it here keeps one React version in the tree."
  },
  "overrides": {
    "react-dom": "19.2.3"
  },
  "dependencies": {
    "expo": "~57.0.12",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-mlkit-ocr": "^0.2.7",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "i18next": "^26.3.6",
    "llama.rn": "^0.12.9",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
